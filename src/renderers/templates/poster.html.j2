<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ poster_title }} - Poster</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
{% set cs = color_scheme or {} %}
<style>
:root {
    /* ---- design tokens (theme + blueprint overrides, with safe fallbacks) ---- */
    --poster-primary: {{ cs.get('primary') or '#16324f' }};
    --poster-blue: var(--poster-primary);
    --poster-accent: {{ cs.get('accent') or '#c9a84c' }};
    --accent-orange: var(--poster-accent);
    --accent-text: {{ cs.get('accent_text') or '#a8842c' }};
    --poster-dark-blue: {{ cs.get('band_bottom') or '#1f4a75' }};
    --poster-bg: {{ cs.get('background') or '#ffffff' }};
    --panel-soft: {{ cs.get('panel_soft') or cs.get('section_header_bg') or '#f7f9fc' }};
    --text-main: {{ cs.get('text') or '#182433' }};
    --text-muted: {{ cs.get('muted') or '#4a5568' }};
    --border-color: {{ cs.get('border') or '#cfd8e3' }};
    --highlight: {{ cs.get('highlight') or '#8fb3d9' }};
    --header-text: {{ cs.get('header_text') or cs.get('section_header_text') or '#ffffff' }};
    --band-top: {{ cs.get('band_top') or cs.get('primary') or '#16324f' }};
    --band-bottom: {{ cs.get('band_bottom') or cs.get('band_top') or '#1f4a75' }};
    --section-symbol: "{{ cs.get('section_symbol') or '▸ ' }}";
    --radius: {{ cs.get('radius') or '10px' }};
    --radius-sm: 7px;
    --shadow: {{ cs.get('shadow') or '0 6px 16px rgba(22, 50, 79, 0.10)' }};
    --font-display: "Times New Roman", Times, serif;
    --font-body: "Times New Roman", Times, serif;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { min-height: 100%; margin: 0; }
body {
    background: #eef1f5;
    font-family: var(--font-body);
    color: var(--text-main);
    line-height: 1.5;
    padding: 26px 18px;
    display: flex;
    justify-content: center;
}
.poster-container {
    width: {{ poster_width }}px;
    min-height: {{ poster_height }}px;
    max-width: none;
    flex-shrink: 0;
    background: var(--poster-bg);
    box-shadow: var(--shadow);
    border-radius: var(--radius);
    padding: 0;
    overflow: hidden;
    position: relative;
}

/* ================= header ================= */
.header {
    text-align: left;
    padding: 34px 48px 20px;
    margin-bottom: 18px;
}
.hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 30px;
    padding: 6px 14px;
    border: 1px solid color-mix(in srgb, var(--poster-primary) 22%, transparent);
    border-radius: 999px;
    color: var(--poster-primary);
    background: color-mix(in srgb, var(--poster-primary) 6%, transparent);
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease;
}
.hero-link:hover { background: color-mix(in srgb, var(--poster-primary) 12%, transparent); }
.header h1 {
    font-family: var(--font-display);
    font-size: clamp(30px, 3vw, 48px);
    color: var(--poster-primary);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.12;
    text-wrap: balance;
}
.header-rule {
    display: none;
}
.tagline {
    margin-top: 10px;
    color: var(--text-main);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
}
.header .authors {
    font-size: 17px;
    color: var(--text-muted);
    font-weight: 600;
    margin-top: 10px;
}
.header .affiliation {
    font-size: 15px;
    color: var(--text-muted);
}
.header .header-meta {
    display: flex;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
    align-items: baseline;
}
.author-line { font-size: 16px; color: var(--text-muted); margin-top: 8px; flex: 0 1 auto; min-width: 0; }
.header .hero-pill { margin-left: 0; }
.github-icon { width: 18px; height: 18px; display: inline-block; vertical-align: -4px; margin-right: 5px; }
.header .hero-pill { flex: 0 1 auto; white-space: normal; overflow-wrap: anywhere; }

/* ================= grid ================= */
.grid-container {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1.2fr;
    grid-template-areas:
        "motivation overview key_idea"
        "core core core"
        "contributions highlights project";
    gap: 18px;
    padding: 0 22px 22px;
    align-items: stretch;
}
.grid-container > .section-block#sec-contributions,
.grid-container > .section-block#sec-highlights,
.grid-container > .section-block#sec-project {
    align-self: stretch;
    min-height: 190px;
    height: 100%;
}
.grid-container > .section-block#sec-contributions .section-title,
.grid-container > .section-block#sec-highlights .section-title,
.grid-container > .section-block#sec-project .section-title {
    padding-top: 9px;
    padding-bottom: 9px;
}
.grid-container > .section-block#sec-contributions .section-content,
.grid-container > .section-block#sec-highlights .section-content,
.grid-container > .section-block#sec-project .section-content {
    padding: 10px 14px;
    overflow: hidden;
}
.section-block {
    border: 1px solid var(--border-color);
    background: var(--poster-bg);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 0;
    box-shadow: 0 2px 6px rgba(16, 36, 64, 0.04);
}
.section-title {
    background: transparent;
    color: #1D4ED8;
    font-family: "Times New Roman", Times, serif;
    font-size: 1.25em;
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
    padding: 12px 18px;
    border-bottom: none;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    text-align: left;
    justify-content: flex-start;
}

.section-block[data-priority="P0"] { border-width: 3px; box-shadow: 0 8px 20px rgba(22, 50, 79, 0.16); }
.section-block[data-priority="P1"] { border-width: 2px; }
.section-block[data-priority="P2"] { opacity: 0.94; }
.section-block[data-priority="P3"] { opacity: 0.82; }
.section-title .sym {
    color: #1D4ED8;
    font-size: 19px;
    line-height: 1;
}
.section-content {
    padding: 16px 18px;
    font-size: 16px;
    line-height: 1.5;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-height: 0;
    overflow: hidden;
    position: relative;
}
.section-content p { margin: 0; }
.section-content ul, .section-content ol { padding-left: 20px; margin: 2px 0; }
.section-content li { margin-bottom: 6px; }
.section-content li::marker { color: var(--poster-accent); }
.section-content strong { color: var(--poster-primary); font-weight: 700; }
.story-claim { color: var(--poster-primary); font-weight: 700; margin: 0 0 8px; }
.section-content em { color: var(--accent-text); }
.section-content a {
    color: var(--poster-primary);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--poster-accent);
    text-underline-offset: 2px;
}
.mini-visual {
    width: 100%;
    min-height: 110px;
    border: 1px solid color-mix(in srgb, var(--border-color) 92%, var(--poster-accent));
    border-radius: var(--radius-sm);
    background: linear-gradient(180deg, color-mix(in srgb, var(--panel-soft) 72%, transparent), #fff);
    padding: 10px 12px;
    display: grid;
    gap: 8px;
    align-content: start;
    overflow: hidden;
}
.mini-visual-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
}
.mini-node {
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--poster-primary) 22%, var(--border-color));
    background: #fff;
    border-radius: 6px;
    padding: 8px 9px;
    box-shadow: 0 1px 3px rgba(16, 36, 64, 0.05);
}
.mini-node-title {
    color: var(--poster-primary);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.15;
}
.mini-node-copy {
    margin-top: 3px;
    color: var(--text-muted);
    font-size: 11px;
    line-height: 1.25;
}
.mini-pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}
.mini-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--poster-primary) 7%, #fff);
    border: 1px solid color-mix(in srgb, var(--poster-primary) 18%, var(--border-color));
    color: var(--poster-primary);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
}
.accent-text, .highlight-orange { color: var(--accent-text); font-weight: 700; }
.muted { color: var(--text-muted); }

/* ================= callouts / formulas ================= */
.callout {
    background: var(--panel-soft);
    border-left: 4px solid var(--poster-accent);
    padding: 9px 13px;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 15px;
}
.callout.alt { border-left-color: var(--poster-primary); }
.formula-box {
    background: var(--panel-soft);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--poster-accent);
    padding: 10px 13px;
    border-radius: var(--radius-sm);
    font-size: 15px;
}
.formula-label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--accent-text);
    font-weight: 800;
    margin-bottom: 6px;
}
.key-idea-formulas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
}
.key-idea-formulas .formula-box {
    min-width: 0;
    padding: 8px 10px;
    font-size: 13px;
}
.key-idea-formulas .formula-label { font-size: 12px; margin-bottom: 4px; }
.key-idea-formulas mjx-container[display="true"] {
    font-size: 0.82em !important;
    margin: 0.28em 0 !important;
}
#sec-key-idea .figure-stack { grid-column: 1 / -1; }

/* ================= figures ================= */
.figure-stack { display: grid; gap: 10px; }
.figure-stack.one { grid-template-columns: 1fr; }
.figure-stack.two { grid-template-columns: 1fr 1fr; }
.figure-card {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: #fff;
    padding: 7px;
}
.figure-card img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 5px;
    object-fit: contain;
    background: #fbfcfe;
}
.figure-description {
    margin-bottom: 6px;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.25;
}
.figure-card.method-card img { max-height: 360px; }
.figure-card.result-card img { max-height: 300px; }
.figure-card.method-card { border-color: color-mix(in srgb, var(--poster-accent) 60%, var(--border-color)); }
.blank-region-supplement {
    position: absolute;
    z-index: 3;
    margin: 0;
    padding: 0;
    overflow: hidden;
    pointer-events: none;
}
.blank-region-supplement img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: fill;
    border-radius: 5px;
}
.mini-visual:has(.blank-region-supplement) {
    width: 0;
    height: 0;
    min-height: 0;
    padding: 0;
    border: 0;
    overflow: visible;
}

/* ================= core band ================= */
.core-band { grid-area: core; }
.core-band .section-content { gap: 12px; }
.core-band-title {
    background: transparent;
    border-bottom: none;
}
.core-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 12px;
    align-items: start;
}
.core-grid.two-col { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
.core-grid.one-col { grid-template-columns: minmax(0, 1fr); }
.core-column { min-width: 0; display: flex; flex-direction: column; gap: 10px; }
.core-column .section-copy { font-size: 16px; line-height: 1.5; }

/* ================= tables ================= */
.core-table-wrap, .table-wrap { width: 100%; max-width: 100%; overflow: hidden; }
.core-table-header { display: flex; flex-direction: column; gap: 5px; margin-bottom: 8px; }
.core-table-caption { font-size: 14px; font-weight: 700; color: var(--poster-primary); }
.core-table-meta { font-size: 12px; color: var(--text-muted); line-height: 1.35; }
table { width: 100%; border-collapse: collapse; margin: 4px 0 0; font-size: 14px; }
th, td { border: 1px solid var(--border-color); padding: 7px 9px; text-align: left; vertical-align: top; }
th {
    background: var(--panel-soft);
    color: var(--poster-primary);
    font-weight: 700;
    border-bottom: 2px solid var(--poster-accent);
}
tbody tr:nth-child(even) { background: color-mix(in srgb, var(--panel-soft) 55%, transparent); }
.core-table-wrap th, .core-table-wrap td { border: 1px solid var(--border-color); padding: 7px 9px; text-align: left; vertical-align: top; }
.core-table-wrap th { background: var(--panel-soft); color: var(--poster-primary); font-weight: 700; }

.core-metrics-table { width: 100%; max-width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 13px; margin: 0; }
.core-metrics-table th, .core-metrics-table td { border: 1px solid var(--border-color); padding: 5px 6px; text-align: center; vertical-align: middle; }
.core-metrics-table th { background: color-mix(in srgb, var(--poster-primary) 8%, var(--poster-bg)); color: var(--poster-primary); font-weight: 800; }
.core-metrics-table th:first-child, .core-metrics-table td:first-child { text-align: left; font-weight: 700; }
.core-metrics-table th, .core-metrics-table td { max-width: 150px; overflow-wrap: anywhere; word-break: break-word; }

.core-empty, .figure-placeholder { display: none; }

/* ================= project / code link ================= */
.project-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-align: center;
    flex: 1;
    min-height: 0;
}
.code-cta { display: flex; flex-direction: column; gap: 6px; width: 100%; }
.code-cta .label { font-size: 15px; color: var(--text-muted); font-weight: 600; }
.code-link {
    word-break: break-all;
    color: var(--poster-primary);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--poster-accent);
    padding-bottom: 1px;
}
.code-link:hover { text-decoration: underline; }
.link-text { font-size: 15px; font-weight: 600; color: var(--poster-primary); word-break: break-all; }

/* ================= highlight markers ================= */
.highlight-marker-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 10px;
    align-items: start;
    width: 100%;
    max-width: 330px;
    margin: auto;
}
.highlight-marker {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 8px;
    align-items: start;
    min-width: 0;
}
.highlight-marker-symbol {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    color: var(--poster-accent);
    font-size: 28px;
    line-height: 1;
    font-weight: 800;
}
.highlight-marker-copy { min-width: 0; }
.highlight-marker-title {
    color: var(--poster-primary);
    font-size: 12px;
    line-height: 1.15;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}
.highlight-marker-desc {
    margin-top: 3px;
    color: var(--text-muted);
    font-size: 10px;
    line-height: 1.25;
}
.grid-container > .section-block#sec-highlights .section-content {
    align-items: center;
    justify-content: center;
}
.highlights-svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
}
.highlights-fallback {
    width: 100%;
    padding-left: 20px;
    display: grid;
    gap: 8px;
    color: var(--text-main);
    font-size: 14px;
    line-height: 1.3;
}
.highlights-fallback li::marker {
    color: var(--poster-accent);
    font-weight: 700;
}
.row-equal {
    align-self: stretch;
    min-height: 190px;
}
.row-equal .section-content {
    height: 100%;
}
.project-footer { margin-top: 8px; font-size: 13px; color: var(--text-muted); letter-spacing: 0.3px; }

/* ================= responsive ================= */
@media (max-width: 1100px) {
    .grid-container {
        grid-template-columns: 1fr;
        grid-template-areas:
            "motivation"
            "overview"
            "key_idea"
            "core"
            "contributions"
            "highlights"
            "project";
    }
    .figure-stack.two { grid-template-columns: 1fr; }
    .key-idea-formulas { grid-template-columns: 1fr; }
}

/* ================= print ================= */
@media print {
    @page { size: {{ (poster_width / 96.0)|round(2) }}in {{ (poster_height / 96.0)|round(2) }}in; margin: 0; }
    body { background: white; padding: 0; }
    .poster-container { box-shadow: none; border-radius: 0; border-top: none; }
}
</style>
</head>
<body>

<div class="poster-container">
    <header class="header">
        <h1>{{ poster_title }}</h1>
        <div class="header-rule"></div>
        {% if tagline %}
        <div class="tagline">{{ tagline }}</div>
        {% endif %}
        <div class="header-meta">
            {% if author_line %}<div class="author-line">{{ author_line }}</div>{% endif %}
            {% if code_url %}
            <a class="hero-pill hero-link" href="{{ code_url }}" target="_blank" rel="noreferrer noopener">
                {% if github_src %}<img class="github-icon" src="{{ github_src }}" alt="GitHub">{% endif %}{{ code_url }}
            </a>
            {% endif %}
        </div>
    </header>

    <div class="grid-container">
        {% set ns = namespace(motivation=None, overview=None, key_idea=None, core_method=None, core_results=None, contributions=None, highlights=None, project=None) %}
        {% for sec in layout %}
            {% if sec.type == 'motivation' %}
                {% set ns.motivation = sec %}
            {% elif sec.type == 'method_overview' %}
                {% set ns.overview = sec %}
            {% elif sec.type == 'key_idea' %}
                {% set ns.key_idea = sec %}
            {% elif sec.type == 'main_method' %}
                {% set ns.core_method = sec %}
            {% elif sec.type == 'experiments' %}
                {% set ns.core_results = sec %}
            {% elif sec.type == 'contributions' %}
                {% set ns.contributions = sec %}
            {% elif sec.type == 'highlights' %}
                {% set ns.highlights = sec %}
            {% elif sec.type == 'project_link' %}
                {% set ns.project = sec %}
            {% endif %}
        {% endfor %}
        {% set sym = cs.get('section_symbol') or '▸ ' %}

        <div class="section-block row-equal" id="sec-motivation" data-priority="{{ ns.motivation.visual_priority if ns.motivation else 'P2' }}" style="grid-area: motivation;">
            <div class="section-title"><span class="sym">📑</span>{{ ns.motivation.title if ns.motivation else 'Motivation' }}</div>
            <div class="section-content">
                {% if ns.motivation %}
                    {{ ns.motivation.content_html|safe }}
                {% else %}
                    (not provided)
                {% endif %}
                {% if ns.motivation and ns.motivation.supplement_html %}
                <div class="mini-visual">{{ ns.motivation.supplement_html|safe }}</div>
                {% endif %}
            </div>
        </div>

        <div class="section-block row-equal" id="sec-method-overview" data-priority="{{ ns.overview.visual_priority if ns.overview else 'P1' }}" style="grid-area: overview;">
            <div class="section-title"><span class="sym">⚙</span>{{ ns.overview.title if ns.overview else 'Method Overview' }}</div>
            <div class="section-content">
                {% if ns.overview %}
                    {{ ns.overview.content_html|replace('[[METHOD_FORMULA]]', '')|safe }}
                {% else %}
                    (not provided)
                {% endif %}
                {% if ns.overview and ns.overview.supplement_html %}
                <div class="mini-visual">{{ ns.overview.supplement_html|safe }}</div>
                {% endif %}
                {% set overview_figs = figure_map.get(ns.overview.section_id, []) if ns.overview else [] %}
                {% if overview_figs %}
                <div class="figure-stack one">
                    {% for fig in overview_figs[:1] %}
                    {% if fig.src %}
                    <div class="figure-card method-card">
                        <div class="figure-description">{{ fig.description }}</div>
                        <img src="{{ fig.src }}" alt="">
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>

        <div class="section-block row-equal" id="sec-key-idea" data-priority="{{ ns.key_idea.visual_priority if ns.key_idea else 'P1' }}" style="grid-area: key_idea;">
            <div class="section-title"><span class="sym">💡</span>{{ ns.key_idea.title if ns.key_idea else 'Key Idea' }}</div>
            <div class="section-content">
                {% if ns.key_idea %}
                    {{ ns.key_idea.content_html|safe }}
                {% else %}
                    (not provided)
                {% endif %}
                {% if ns.key_idea and ns.key_idea.supplement_html %}
                <div class="mini-visual">{{ ns.key_idea.supplement_html|safe }}</div>
                {% endif %}
                {% set key_figs = figure_map.get(ns.key_idea.section_id, []) if ns.key_idea else [] %}
                {% if key_figs %}
                <div class="figure-stack one">
                    {% for fig in key_figs[:1] %}
                    {% if fig.src %}
                    <div class="figure-card">
                        <div class="figure-description">{{ fig.description }}</div>
                        <img src="{{ fig.src }}" alt="">
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>

        <div class="section-block core-band" id="sec-main-method" data-priority="{{ (ns.core_results or ns.core_method).visual_priority if (ns.core_results or ns.core_method) else 'P0' }}" style="grid-area: core;">
            <div class="section-title core-band-title"><span class="sym">🏆</span>Core Results</div>
            <div class="section-content">
                {% set core_figs = namespace(items=[]) %}
                {% if ns.core_results %}
                    {% for fig in figure_map.get(ns.core_results.section_id, []) %}
                        {% set _ = core_figs.items.append(fig) %}
                    {% endfor %}
                {% endif %}
                {% if ns.core_method %}
                    {% for fig in figure_map.get(ns.core_method.section_id, []) %}
                        {% set _ = core_figs.items.append(fig) %}
                    {% endfor %}
                {% endif %}
                {# 仅保留可渲染（有 src）的图，按实际图数自适应列布局，绝不留空列 #}
                {% set core_ok = namespace(items=[]) %}
                {% for fig in core_figs.items %}
                    {% if fig.src %}{% set _ = core_ok.items.append(fig) %}{% endif %}
                {% endfor %}
                {% set left_fig = core_ok.items[0] if core_ok.items|length > 0 else None %}
                {% set right_fig = core_ok.items[1] if core_ok.items|length > 1 else None %}
                {% set n_figs = core_ok.items|length %}
                {% set center_source = ns.core_results if ns.core_results else ns.core_method %}
                {% set has_table = center_source and center_source.content_html and '[[CORE_TABLE]]' in center_source.content_html %}
                {% if center_source %}
                {% set core_intro = center_source.content_html.split('[[CORE_TABLE]]')[0] %}
                {% if core_intro|lower|trim not in ['core results', '<h1>core results</h1>', '<h2>core results</h2>', '<h3>core results</h3>', '<h4>core results</h4>', '<h5>core results</h5>', '<h6>core results</h6>'] %}
                <div class="section-copy">{{ core_intro|safe }}</div>
                {% endif %}
                {% endif %}
                <div class="core-grid {{ 'two-col' if n_figs == 1 else ('one-col' if n_figs == 0 else '') }}">
                    {% if left_fig %}
                    <div class="core-column">
                        <div class="figure-card result-card">
                            <div class="figure-description">{{ left_fig.description }}</div>
                            <img src="{{ left_fig.src }}" alt="">
                        </div>
                    </div>
                    {% endif %}
                {% if has_table %}
                    <div class="core-column">
                        {% set core_table = center_source.content_html.split('[[CORE_TABLE]]')[-1].strip() %}
                        {{ core_table|safe }}
                    </div>
                {% endif %}
                    {% if right_fig %}
                    <div class="core-column">
                        <div class="figure-card result-card">
                            <div class="figure-description">{{ right_fig.description }}</div>
                            <img src="{{ right_fig.src }}" alt="">
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="section-block row-equal" id="sec-contributions" data-priority="{{ ns.contributions.visual_priority if ns.contributions else 'P3' }}" style="grid-area: contributions;">
            <div class="section-title"><span class="sym">⭐</span>{{ ns.contributions.title if ns.contributions else 'Contributions' }}</div>
            <div class="section-content">
                {% if ns.contributions %}
                    {{ ns.contributions.content_html|safe }}
                {% else %}
                    (not provided)
                {% endif %}
                {% if ns.contributions and ns.contributions.supplement_html %}
                <div class="mini-visual">{{ ns.contributions.supplement_html|safe }}</div>
                {% endif %}
            </div>
        </div>

        <div class="section-block row-equal" id="sec-highlights" data-priority="{{ ns.highlights.visual_priority if ns.highlights else 'P3' }}" style="grid-area: highlights;">
            <div class="section-title"><span class="sym">⚡</span>{{ ns.highlights.title if ns.highlights else 'Highlights' }}</div>
            <div class="section-content">
                {% if ns.highlights and ns.highlights.highlights_svg_ref %}
                <img class="highlights-svg" src="{{ ns.highlights.highlights_svg_ref }}" alt="Four paper highlights">
                {% elif ns.highlights and ns.highlights.highlights_items %}
                <ul class="highlights-fallback">
                    {% for item in ns.highlights.highlights_items %}
                    <li>{{ item }}</li>
                    {% endfor %}
                </ul>
                {% endif %}
            </div>
        </div>

        <div class="section-block row-equal" id="sec-project" data-priority="{{ ns.project.visual_priority if ns.project else 'P3' }}" style="grid-area: project;">
            <div class="section-title"><span class="sym">{% if github_src %}<img class="github-icon" src="{{ github_src }}" alt="GitHub">{% else %}◉{% endif %}</span>{{ ns.project.title if ns.project else 'Project' }}</div>
            <div class="section-content">
                <div class="project-box">
                    <div class="code-cta">
                        <div class="label">Code & Project</div>
                        {% if code_url %}
                        <a class="code-link" href="{{ code_url }}" target="_blank" rel="noreferrer noopener">{{ code_url }}</a>
                        {% else %}
                        <div class="link-text">Code will be released.</div>
                        {% endif %}
                    </div>
                </div>
                {% if ns.project and ns.project.supplement_html %}
                <div class="mini-visual">{{ ns.project.supplement_html|safe }}</div>
                {% endif %}
                <div class="project-footer">Paper-to-Poster · Research Reader</div>
            </div>
        </div>

<script>
MathJax = { tex: { inlineMath: [['$', '$']] } };
</script>
<script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" async></script>

</body>
</html>
