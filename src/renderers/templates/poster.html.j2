<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ poster_title }} - Poster</title>
<style>
:root {
    --bg: {{ color_scheme.background }};
    --panel: #ffffff;
    --panel-weak: #f7f9fc;
    --ink: {{ color_scheme.text }};
    --muted: #5f6b7a;
    --border: {{ color_scheme.border }};
    --primary: {{ color_scheme.primary }};
    --accent: {{ color_scheme.accent }};
    --highlight: {{ color_scheme.highlight }};
}
* { box-sizing: border-box; }
html, body { min-height: 100%; }
body {
    margin: 0;
    background:
        radial-gradient(circle at top left, rgba(25, 45, 74, 0.08), transparent 28%),
        radial-gradient(circle at top right, rgba(102, 151, 198, 0.08), transparent 24%),
        var(--bg);
    color: var(--ink);
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
    line-height: 1.5;
}
.page {
    width: min({{ poster_width }}px, calc(100vw - 32px));
    margin: 16px auto 24px;
}
.poster {
    background: linear-gradient(180deg, rgba(255,255,255,0.95), #ffffff 120px);
    border: 1px solid rgba(18, 32, 49, 0.08);
    box-shadow: 0 18px 60px rgba(18, 32, 49, 0.14);
    overflow: hidden;
}
.hero {
    padding: 32px 34px 24px;
    background:
        linear-gradient(135deg, rgba(22, 50, 79, 0.98), rgba(22, 50, 79, 0.92)),
        linear-gradient(90deg, rgba(90, 125, 154, 0.8), rgba(143, 179, 217, 0.55));
    color: white;
    border-bottom: 1px solid rgba(255,255,255,0.12);
}
.hero-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
}
.hero-title-group {
    min-width: 0;
    flex: 1 1 auto;
}
.hero-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
}
.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 999px;
    font-size: 12px;
    letter-spacing: 0;
    opacity: 0.95;
}
.hero-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    padding: 5px 10px;
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 999px;
    color: rgba(255,255,255,0.96);
    background: rgba(255,255,255,0.08);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
}
.hero-link {
    background: rgba(255,255,255,0.12);
}
.hero-link:hover {
    background: rgba(255,255,255,0.18);
}
.hero h1 {
    margin: 16px 0 8px;
    font-size: 30px;
    line-height: 1.1;
    letter-spacing: 0;
    font-weight: 800;
    max-width: none;
    width: 100%;
    display: block;
    text-wrap: balance;
    overflow-wrap: normal;
    word-break: normal;
}
.authors {
    max-width: 70ch;
    color: rgba(255,255,255,0.88);
    font-size: 15px;
}
.content {
    padding: 14px;
}
.layout-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas:
        "motivation results"
        "method results"
        "contribution keytakeaways";
    grid-template-rows: minmax(112px, auto) minmax(140px, auto) minmax(132px, auto);
    gap: 12px;
    align-items: start;
}
.motivation-section {
    height: auto;
    align-self: start;
}
.motivation-section .section-body {
    padding: 8px 12px 9px;
    gap: 6px;
}
.motivation-section .section-body p {
    margin-bottom: 4px;
}
.motivation-section .section-body p:last-child {
    margin-bottom: 0;
}
.section {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    min-height: 0;
    align-self: stretch;
    height: 100%;
    display: flex;
    flex-direction: column;
}
.section-header {
    background: linear-gradient(180deg, rgba(232, 238, 244, 0.95), rgba(245, 248, 251, 0.95));
    padding: 8px 12px;
    color: var(--primary);
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}
.section-body {
    padding: 11px 12px 12px;
    font-size: 12px;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1 1 auto;
}
.section-body p { margin: 0 0 8px; }
.section-body p:last-child { margin-bottom: 0; }
.section-body ul, .section-body ol { margin: 8px 0; padding-left: 18px; }
.section-body li { margin-bottom: 5px; }
.section-body strong { color: var(--primary); }
.section-body blockquote {
    margin: 10px 0;
    padding: 10px 12px;
    border-left: 3px solid var(--accent);
    background: var(--panel-weak);
    color: var(--muted);
}
.section-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 8px 0;
    font-size: 12px;
}
.section-body th, .section-body td {
    border: 1px solid #d8e1ea;
    padding: 7px 8px;
    text-align: left;
    vertical-align: top;
}
.section-body th {
    background: #edf3f8;
    color: var(--primary);
    font-weight: 700;
}
.figure-stack {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    align-content: start;
    justify-items: stretch;
}
.figure-stack.method-hero {
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
}
.figure-stack.results-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}
.figure-stack.results-single {
    grid-template-columns: minmax(0, 1fr);
}
.figure-card {
    border: 1px solid #d8e0ea;
    border-radius: 8px;
    background: #fff;
    padding: 7px;
    align-self: start;
}
.figure-card.full { grid-column: 1 / -1; }
.figure-card.method-hero-card {
    width: min(100%, 680px);
}
.figure-card.result-card {
    min-height: 0;
}
.figure-card img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
}
.figure-card.method-hero-card img,
.figure-card.result-card img {
    width: 100%;
    max-height: 280px;
    object-fit: contain;
    background: #fbfcfe;
}
.figure-caption {
    margin-top: 6px;
    font-size: 11px;
    line-height: 1.35;
    color: var(--muted);
}
.figure-placeholder {
    min-height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
    background: #f6f8fb;
    color: #748191;
    border: 1px dashed #c6d3df;
    border-radius: 6px;
}
.footer {
    padding: 0 16px 16px;
}
.footer-band {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: linear-gradient(180deg, #fbfdff, #f4f8fc);
    color: var(--muted);
    font-size: 12px;
}
.footer-band strong { color: var(--primary); }
@media (min-width: 1101px) {
    .section { min-height: 100%; }
}
@media (max-width: 1100px) {
    .layout-grid {
        grid-template-columns: 1fr;
        grid-template-areas:
            "motivation"
            "method"
            "results"
            "contribution"
            "keytakeaways";
    }
}
@media print {
    body { background: white; }
    .page { width: 100%; margin: 0; }
    .poster { box-shadow: none; border: none; }
}
</style>
</head>
<body>
<div class="page">
  <div class="poster">
    <header class="hero">
      <div class="hero-top">
        <div class="hero-title-group">
          <div class="hero-badge-row">
            <div class="hero-badge">Paper-to-Poster Research Reader</div>
            {% if code_url %}
            <a class="hero-pill hero-link" href="{{ code_url }}" target="_blank" rel="noreferrer noopener">{{ code_url }}</a>
            {% endif %}
          </div>
          <h1>{{ poster_title }}</h1>
          {% if authors_str %}
          <div class="authors">{{ authors_str }}</div>
          {% endif %}
        </div>
      </div>
    </header>

    <main class="content">
      <section class="layout-grid">
        {% for sec in layout %}
        <article class="section {% if sec.type == 'motivation' %}motivation-section{% endif %}" style="grid-area: {% if sec.type == 'motivation' %}motivation{% elif sec.type == 'main_method' %}method{% elif sec.type == 'experiments' %}results{% elif sec.type == 'contributions' %}contribution{% elif sec.type == 'highlights' %}keytakeaways{% else %}auto{% endif %};">
          <div class="section-header">{{ sec.title }}</div>
          <div class="section-body">
            {{ sec.content_html|safe }}
            {% set section_figs = figure_map.get(sec.section_id, []) %}
            {% if section_figs %}
            <div class="figure-stack {% if sec.type == 'main_method' %}method-hero{% elif sec.type == 'experiments' %}{% if section_figs|length > 1 %}results-grid{% else %}results-single{% endif %}{% endif %}">
              {% for fig in section_figs %}
              <div class="figure-card {% if sec.type == 'main_method' and loop.first %}method-hero-card{% elif sec.type == 'experiments' %}result-card{% endif %} {% if fig.width_ratio >= 0.8 %}full{% endif %}">
                {% if fig.src %}
                <img src="{{ fig.src }}" alt="{{ fig.caption }}">
                {% else %}
                <div class="figure-placeholder">Figure unavailable: {{ fig.caption }}</div>
                {% endif %}
                {% if fig.caption %}
                <div class="figure-caption">{{ fig.caption }}</div>
                {% endif %}
              </div>
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </article>
        {% endfor %}
      </section>
    </main>

    <footer class="footer">
      <div class="footer-band">
        <div><strong>Reader mode:</strong> optimized for quick paper comprehension and poster export.</div>
        <div><strong>Validation:</strong> render, inspect, refine.</div>
      </div>
    </footer>
  </div>
</div>
<script>
MathJax = { tex: { inlineMath: [['$', '$'], ['\\(', '\\)']] } };
</script>
<script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" async></script>
</body>
</html>
