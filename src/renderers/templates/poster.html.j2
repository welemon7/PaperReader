<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ poster_title }} - Poster</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
    --poster-blue: {{ color_scheme.primary }};
    --poster-dark-blue: #072245;
    --poster-bg: #ffffff;
    --border-color: {{ color_scheme.border }};
    --text-main: {{ color_scheme.text }};
    --text-muted: #4a5568;
    --accent-orange: {{ color_scheme.accent }};
    --panel-soft: #f7f9fc;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { min-height: 100%; }
body {
    background: #e9ecf1;
    font-family: 'Inter', sans-serif;
    color: var(--text-main);
    line-height: 1.5;
    padding: 30px 20px;
    display: flex;
    justify-content: center;
}
.poster-container {
    max-width: 1400px;
    width: 100%;
    background: var(--poster-bg);
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    padding: 20px;
}
.header {
    text-align: center;
    padding-bottom: 15px;
    border-bottom: 2px solid var(--border-color);
    margin-bottom: 15px;
}
.hero-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    padding: 5px 10px;
    border: 1px solid rgba(11, 47, 101, 0.18);
    border-radius: 999px;
    color: var(--poster-blue);
    background: rgba(11, 47, 101, 0.06);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
}
.hero-link:hover { background: rgba(11, 47, 101, 0.1); }
.header h1 {
    font-size: 32px;
    color: var(--poster-blue);
    font-weight: 800;
    letter-spacing: 0;
    margin-bottom: 4px;
    text-wrap: balance;
}
.header .authors {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 600;
    margin-top: 2px;
}
.header .affiliation {
    font-size: 13px;
    color: var(--text-muted);
}
.grid-container {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    grid-template-areas:
        "motivation overview key_idea"
        "core core core"
        "contributions highlights project";
    gap: 15px;
}
.section-block {
    border: 1px solid var(--border-color);
    background: #fff;
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 0;
}
.section-title {
    background: var(--poster-blue);
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    text-align: center;
    padding: 8px 10px;
    letter-spacing: 0.5px;
    flex-shrink: 0;
}
.section-content {
    padding: 12px 14px;
    font-size: 13px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.section-content p { margin: 0; }
.section-content ul, .section-content ol { padding-left: 18px; margin: 5px 0; }
.section-content li { margin-bottom: 5px; }
.section-content strong { color: var(--poster-blue); }
.highlight-orange { color: var(--accent-orange); font-weight: 700; }
.muted { color: var(--text-muted); }
.callout {
    background: #f8fafc;
    border-left: 4px solid var(--poster-blue);
    padding: 8px 12px;
    font-size: 12px;
}
.callout.alt { border-left-color: var(--accent-orange); }
.figure-stack {
    display: grid;
    gap: 10px;
}
.figure-stack.one { grid-template-columns: 1fr; }
.figure-stack.two { grid-template-columns: 1fr 1fr; }
.figure-card {
    border: 1px solid var(--border-color);
    border-radius: 4px;
    background: #fff;
    padding: 7px;
}
.figure-card img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 3px;
    object-fit: contain;
    background: #fbfcfe;
}
.figure-card.method-card img,
.figure-card.result-card img {
    max-height: 260px;
}
.figure-caption {
    margin-top: 6px;
    font-size: 11px;
    line-height: 1.35;
    color: var(--text-muted);
}
.figure-placeholder {
    min-height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
    background: #f6f8fb;
    color: #748191;
    border: 1px dashed #c6d3df;
    border-radius: 6px;
}
.table-wrap { overflow-x: auto; }
table {
    width: 100%;
    border-collapse: collapse;
    margin: 4px 0 0;
    font-size: 12px;
}
th, td {
    border: 1px solid #d8e1ea;
    padding: 7px 8px;
    text-align: left;
    vertical-align: top;
}
th {
    background: #edf3f8;
    color: var(--poster-blue);
    font-weight: 700;
}
.code-link {
    word-break: break-all;
    color: var(--poster-blue);
    font-weight: 700;
    text-decoration: none;
}
.code-link:hover { text-decoration: underline; }
.project-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-align: center;
    min-height: 100%;
}
.qr-placeholder {
    width: 80px;
    height: 80px;
    background: #000;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
}
.link-text {
    font-size: 12px;
    font-weight: 600;
    color: var(--poster-blue);
    word-break: break-all;
}
.code-cta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
}
.code-cta .label {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 600;
}
.grid-area-motivation { grid-area: motivation; }
.grid-area-overview { grid-area: overview; }
.grid-area-keyidea { grid-area: key_idea; }
.grid-area-core { grid-area: core; }
.grid-area-contributions { grid-area: contributions; }
.grid-area-highlights { grid-area: highlights; }
.grid-area-project { grid-area: project; }
@media (max-width: 1100px) {
    .grid-container {
        grid-template-columns: 1fr;
        grid-template-areas:
            "motivation"
            "overview"
            "key_idea"
            "core"
            "contributions"
            "highlights"
            "project";
    }
    .figure-stack.two { grid-template-columns: 1fr; }
}
@media print {
    body { background: white; padding: 0; }
    .poster-container { box-shadow: none; border: none; }
}
</style>
</head>
<body>

<div class="poster-container">
    <header class="header">
        <h1>{{ poster_title }}</h1>
        {% if authors_str %}
        <div class="authors">{{ authors_str }}</div>
        {% endif %}
        {% if code_url %}
        <div class="grid-area-project" style="margin-top: 8px; margin-bottom: 2px;">
            <a class="hero-pill hero-link" href="{{ code_url }}" target="_blank" rel="noreferrer noopener">{{ code_url }}</a>
        </div>
        {% endif %}
        <div class="affiliation">Paper-to-Poster Research Reader</div>
    </header>

    <div class="grid-container">
        {% for sec in layout %}
        {% set grid_class = 'grid-area-' ~ sec.type %}
        <div class="section-block {{ grid_class }}" style="grid-area: {% if sec.type == 'motivation' %}motivation{% elif sec.type == 'method_overview' %}overview{% elif sec.type == 'key_idea' %}key_idea{% elif sec.type == 'main_method' %}core{% elif sec.type == 'contributions' %}contributions{% elif sec.type == 'highlights' %}highlights{% elif sec.type == 'project_link' %}project{% else %}core{% endif %};">
            <div class="section-title">{{ sec.title }}</div>
            <div class="section-content">
                {% if sec.type == 'project_link' %}
                <div class="project-box">
                    <div class="qr-placeholder">[QR]</div>
                    <div class="code-cta">
                        <div class="label">Code & Project</div>
                        {% if code_url %}
                        <a class="code-link" href="{{ code_url }}" target="_blank" rel="noreferrer noopener">{{ code_url }}</a>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
                {{ sec.content_html|safe }}
                {% set section_figs = figure_map.get(sec.section_id, []) %}
                {% if section_figs %}
                <div class="figure-stack {% if sec.type in ['method_overview', 'main_method'] %}one{% elif section_figs|length > 1 %}two{% else %}one{% endif %}">
                    {% for fig in section_figs %}
                    <div class="figure-card {% if sec.type in ['method_overview', 'main_method'] %}method-card{% elif sec.type == 'experiments' %}result-card{% endif %}">
                        {% if fig.src %}
                        <img src="{{ fig.src }}" alt="{{ fig.caption }}">
                        {% else %}
                        <div class="figure-placeholder">Figure unavailable: {{ fig.caption }}</div>
                        {% endif %}
                        {% if fig.caption %}
                        <div class="figure-caption">{{ fig.caption }}</div>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
</div>

<script>
MathJax = { tex: { inlineMath: [['$', '$'], ['\\(', '\\)']] } };
</script>
<script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" async></script>

</body>
</html>
